# PlanPal hackathon configuration
# Public attribution identifier; keep this in any future counted Celo transaction builder.
CELO_ATTRIBUTION_TAG=celo_e667c914009d

# Self Agent ID / Celo network selection. Real passports use mainnet; testnet uses mock passports.
SELF_AGENT_NETWORK=testnet
CELO_RPC_URL=https://forno.celo.org
CELO_TESTNET_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
PLANPAL_AGENT_POLICY_MODE=demo
# One-time human-approved QR flow for binding the existing agent key to Self proof.
PLANPAL_SELF_REGISTRATION_ENABLED=false

# Protected server-side values. Configure these through secure project configuration.
AGENT_PRIVATE_KEY=
X402_API_KEY=
X402_PAYTO_ADDRESS=

# x402 buyer safety and resource metadata.
X402_FACILITATOR_URL=https://api.x402.celo.org
X402_RESOURCE_URL=https://planpal.app/premium-recommendation
X402_MAX_AMOUNT_USDC=0.05

# Development safety: live settlement stays off until wallet, pay-to, and facilitator setup are reviewed.
ENABLE_LIVE_CELO_TX=false
